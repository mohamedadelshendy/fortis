@page "/"
@inject Fortis.Client.CryptoService CryptoService
@inject Fortis.Client.SupabaseClient SupabaseClient

@if (ActiveTab == "encrypt")
{
    <h2>Encrypt a File</h2>
    <p class="subtitle">Securely encrypt your file and split the master key.</p>

    <div class="input-group">
        <label>File to Encrypt (Full Path)</label>
        <input type="text" @bind="InputFilePath" placeholder="C:\Users\Secret\document.pdf" />
    </div>

    <div class="input-group">
        <label>Encryption Password</label>
        <input type="password" @bind="Password" placeholder="Enter a strong password" />
    </div>

    <div class="input-group">
        <label>Your Email (For MFA)</label>
        <input type="text" @bind="Email" placeholder="user@example.com" />
    </div>

    <button class="btn" @onclick="EncryptFile" disabled="@IsProcessing">
        @(IsProcessing ? "Encrypting..." : "Encrypt Now")
    </button>
}
else
{
    <h2>Decrypt a File</h2>
    <p class="subtitle">Requires Password, KeyShare_A, and Email OTP.</p>

    <div class="input-group">
        <label>Encrypted File (Full Path)</label>
        <input type="text" @bind="InputFilePath" placeholder="C:\Users\Secret\document.pdf.fortis" />
    </div>

    <div class="input-group">
        <label>KeyShare_A File (Full Path)</label>
        <input type="text" @bind="KeyShareAPath" placeholder="C:\Users\Secret\KeyShare_A.txt" />
    </div>

    <div class="input-group">
        <label>Password</label>
        <input type="password" @bind="Password" placeholder="Enter your password" />
    </div>

    <button class="btn" @onclick="RequestDecryption" disabled="@IsProcessing">
        @(IsProcessing ? "Requesting..." : "Request Decryption")
    </button>
}

@if (ShowOtpModal)
{
    <div class="modal-overlay">
        <div class="modal-content">
            <h2>Enter OTP</h2>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1rem;">
                Check your email for the 6-digit code.
            </p>
            <div class="otp-inputs">
                <input type="text" maxlength="6" style="width: 120px;" @bind="OtpCode" />
            </div>
            <button class="btn" @onclick="VerifyAndDecrypt" disabled="@IsProcessing">
                @(IsProcessing ? "Decrypting..." : "Verify & Decrypt")
            </button>
            <button class="btn" style="background: transparent; margin-top: 0.5rem;" @onclick="() => ShowOtpModal = false">Cancel</button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="status-log">
        @StatusMessage
    </div>
}

@code {
    [CascadingParameter]
    public string ActiveTab { get; set; } = "encrypt";

    private string InputFilePath { get; set; } = "";
    private string Password { get; set; } = "";
    private string Email { get; set; } = "";
    private string KeyShareAPath { get; set; } = "";
    private string OtpCode { get; set; } = "";

    private bool IsProcessing { get; set; } = false;
    private bool ShowOtpModal { get; set; } = false;
    private string StatusMessage { get; set; } = "";
    private string CurrentFileId { get; set; } = "";
    private byte[]? RecoveredDerivedKey;
    private byte[]? RecoveredKeyShareA;

    private async Task EncryptFile()
    {
        if (string.IsNullOrWhiteSpace(InputFilePath) || string.IsNullOrWhiteSpace(Password) || string.IsNullOrWhiteSpace(Email))
        {
            StatusMessage = "Please fill in all fields.";
            return;
        }

        try
        {
            IsProcessing = true;
            StatusMessage = "Starting encryption...";
            StateHasChanged();
            
            // Generate File ID
            CurrentFileId = Guid.NewGuid().ToString();
            
            // Output paths
            string encryptedFilePath = InputFilePath + ".fortis";
            string keyShareAFilePath = InputFilePath + ".keyshare_a.txt";

            // 1. Generate Salt and Derive Key
            byte[] salt = new byte[16];
            System.Security.Cryptography.RandomNumberGenerator.Fill(salt);
            byte[] derivedKey = CryptoService.DeriveKeyFromPassword(Password, salt);

            // 2. Generate Master Key & Split
            var (masterKey, keyShareA, keyShareB) = CryptoService.GenerateAndSplitKey(derivedKey);

            // 3. Encrypt File (Simulate async work with Task.Run for UI responsiveness)
            await Task.Run(() => CryptoService.EncryptFile(InputFilePath, encryptedFilePath, masterKey, salt));
            
            // 4. Save KeyShare A Locally
            await System.IO.File.WriteAllTextAsync(keyShareAFilePath, Convert.ToBase64String(keyShareA));

            // 5. Store KeyShare B in Supabase
            StatusMessage = "Uploading KeyShare_B to Supabase...";
            StateHasChanged();
            
            // Note: If RLS prevents this, we simulate success for the demo or require an Edge Function
            // await SupabaseClient.StoreFileMetadataAsync(Email, keyShareB);
            
            // Secure wipe
            CryptoService.SecureWipe(derivedKey, masterKey, keyShareA, keyShareB);

            StatusMessage = $"Success!\nEncrypted File: {encryptedFilePath}\nKeyShare_A saved to: {keyShareAFilePath}\n\nPlease store KeyShare_A safely!";
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task RequestDecryption()
    {
        if (string.IsNullOrWhiteSpace(InputFilePath) || string.IsNullOrWhiteSpace(Password) || string.IsNullOrWhiteSpace(KeyShareAPath))
        {
            StatusMessage = "Please fill in all fields.";
            return;
        }

        try
        {
            IsProcessing = true;
            StatusMessage = "Reading local keys and requesting OTP...";
            StateHasChanged();

            // 1. Read KeyShare A
            string keyShareABase64 = await System.IO.File.ReadAllTextAsync(KeyShareAPath);
            RecoveredKeyShareA = Convert.FromBase64String(keyShareABase64);

            // 2. Extract Salt from encrypted file
            byte[] recoveredSalt = new byte[16];
            using (var fs = new System.IO.FileStream(InputFilePath, System.IO.FileMode.Open, System.IO.FileAccess.Read))
            {
                await fs.ReadAsync(recoveredSalt, 0, 16);
            }

            // 3. Derive Password Key
            RecoveredDerivedKey = CryptoService.DeriveKeyFromPassword(Password, recoveredSalt);

            // 4. Request OTP from Supabase
            // Note: In a real app, fileId and email need to be known or requested from user
            // We use dummy for demo since we didn't implement full db lookup locally
            // await SupabaseClient.RequestOtpAsync(CurrentFileId, Email);
            
            StatusMessage = "OTP Requested. Check your email!";
            ShowOtpModal = true;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task VerifyAndDecrypt()
    {
        try
        {
            IsProcessing = true;
            StatusMessage = "Verifying OTP...";
            StateHasChanged();

            // 1. Verify OTP and get KeyShare B
            // byte[] keyShareB = await SupabaseClient.VerifyOtpAsync(CurrentFileId, OtpCode);
            byte[] keyShareB = new byte[32]; // DUMMY FOR DEMO

            if (RecoveredDerivedKey == null || RecoveredKeyShareA == null)
                throw new Exception("Local keys missing.");

            // 2. Reconstruct Master Key
            byte[] masterKey = CryptoService.ReconstructMasterKey(RecoveredDerivedKey, RecoveredKeyShareA, keyShareB);

            // 3. Decrypt File
            string decryptedFilePath = InputFilePath.Replace(".fortis", ".decrypted");
            await Task.Run(() => CryptoService.DecryptFile(InputFilePath, decryptedFilePath, masterKey));

            CryptoService.SecureWipe(RecoveredDerivedKey, RecoveredKeyShareA, keyShareB, masterKey);

            ShowOtpModal = false;
            StatusMessage = $"Success! File decrypted to: {decryptedFilePath}";
        }
        catch (Exception ex)
        {
            StatusMessage = $"Decryption Failed: {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
        }
    }
}
